# === 줄바꿈 정책 ==========================================================
# 저장소(index)에는 LF로 저장하고, 체크아웃 시 CRLF로 변환한다.
# 팀원 각자의 core.autocrlf 설정과 무관하게 동일하게 동작한다.
* text=auto eol=crlf

# === C# 소스 ==============================================================
# 인코딩은 UTF-8. 에디터 단의 강제는 .editorconfig(charset)가 담당한다.
*.cs text eol=crlf working-tree-encoding=UTF-8

# === Unity YAML ===========================================================
# 씬/프리팹/에셋 충돌은 UnityYAMLMerge로 병합한다.
# 각자 1회 설정 (Unity 설치 경로에 맞게):
#   git config merge.unity.name "Unity SmartMerge"
#   git config merge.unity.driver "'C:/Program Files/Unity/Hub/Editor/<버전>/Editor/Data/Tools/UnityYAMLMerge.exe' merge -p %O %B %A %A"
*.unity  text eol=crlf merge=unity
*.prefab text eol=crlf merge=unity
*.asset  text eol=crlf merge=unity
*.meta   text eol=crlf

