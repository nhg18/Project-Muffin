root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
# 한국어 Windows의 Visual Studio가 BOM 없는 파일을 CP949로 되돌리는 사고 방지
charset = utf-8-bom

[*.{unity,prefab,asset,meta}]
# Unity가 생성/관리하는 파일 — 에디터가 형식을 건드리지 않는다
insert_final_newline = false

[*.{md,yml,yaml,json}]
indent_size = 2
