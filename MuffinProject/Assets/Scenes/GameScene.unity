  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\uADDC\uCE59 \uC694\uC57D</b>\n\xB7 2~4\uC778. \uC774\uAE30\uB294 \uAE38\uC740
    \uB458 \u2014 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uAE30 \xB7 \uC190\uD328
    10\uC7A5(\uCC39\uCE04)\uC744 \uB2E4\uC74C \uB0B4 \uD134 \uC2DC\uC791\uAE4C\uC9C0
    \uC9C0\uD0A4\uAE30\n\xB7 \uB0B4 \uD134(15\uCD08)\uC5D0\uB294 \uB458 \uC911 \uD558\uB098
    \u2014 \uCE74\uB4DC 2\uC7A5 \uBF51\uAE30 \xB7 \uD589\uB3D9 \uCE74\uB4DC 1\uC7A5
    \uB0B4\uAE30. \uD568\uC815 \uB193\uAE30\uB294 \uB530\uB85C (\uCD5C\uB300 3\uC7A5)\n\xB7
    \uCE74\uB4DC\uAC00 \uB098\uC624\uBA74 \uBC18\uC751 \uC2DC\uAC04 5\uCD08 \u2014
    \uB0BC \uC218 \uC788\uB294 \uCE74\uC6B4\uD130\uAC00 \uCD08\uB85D\uC73C\uB85C
    \uBE5B\uB09C\uB2E4\n\xB7 HP 100 \uC5D0\uC11C \uC2DC\uC791, 0 \uC774 \uB418\uBA74
    \uD0C8\uB77D\n\n<b>\uC870\uC791\uBC95</b>\n\xB7 PC \u2014 \uC190\uD328\uC5D0
    \uC62C\uB9AC\uBA74 \uC62C\uB77C\uC634 \xB7 \uD074\uB9AD\uC73C\uB85C \uC9D1\uACE0
    \uB2E4\uC2DC \uD074\uB9AD\uC73C\uB85C \uB193\uAE30(\uB04C\uC5B4\uB2E4 \uB193\uAE30\uB3C4
    \uB428) \xB7 \uC0AC\uC6A9 \uAE30\uC900\uC120 \uC704\uB098 \uC0C1\uB300 \uC704\uC5D0
    \uB193\uC73C\uBA74 \uC0AC\uC6A9 \xB7 \uC6B0\uD074\uB9AD \xB7 Esc \uCDE8\uC18C\n\xB7
    \uBAA8\uBC14\uC77C \u2014 \uC88C\uC6B0\uB85C \uD6D1\uC5B4 \uACE0\uB974\uAE30
    \xB7 \uC704\uB85C \uC4F8\uC5B4 \uC62C\uB824 \uC9D1\uAE30 \xB7 \uD0ED\uC73C\uB85C
    \uC9D1\uACE0 \uB2E4\uC2DC \uD0ED\uC73C\uB85C \uB193\uAE30 \xB7 \uAE38\uAC8C \uB20C\uB7EC
    \uD06C\uAC8C \uBCF4\uAE30"
